# Porta do servidor local (padrão 3000)
PORT=3000

# Chave que assina os tokens de sessão (qualquer texto longo e aleatório)
SESSION_SECRET=

# MySQL (DATABASE padrão: autosuporte)
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=autosuporte

# Chave da API da Anthropic (console.anthropic.com)
ANTHROPIC_API_KEY=

# Gerados uma única vez por "npm run criar-agente"
AGENT_ID=
ENVIRONMENT_ID=

# Token do GitHub (fine-grained, só "Contents: Read" nos repositórios dos sistemas).
# Não entra no contêiner do agente: a Anthropic injeta no clone por proxy.
GITHUB_TOKEN=

# Teto de gasto por conversa, em centavos de dólar (100 = US$ 1,00)
ORCAMENTO_CENTAVOS=100

